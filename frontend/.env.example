# Copy to .env.local (gitignored) to inject real tracking IDs into local
# builds. In CI these are set as GitHub Actions repository variables and
# exported before `bun run build` (see .github/workflows/deploy.yml).
# Both are public client-side identifiers, not secrets.
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_FACEBOOK_PIXEL_ID=0000000000000000
