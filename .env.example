# Copy this file to .env and adjust as needed. .env is gitignored.

HOST=127.0.0.1
PORT=8080

# Uncomment to have this process terminate TLS itself (see src/main.rs).
# Point these at a certbot-managed fullchain.pem/privkey.pem, e.g. the paths
# written by deploy/run.sh.
# TLS_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem
# TLS_PORT=443

# Where the visitor counter's sqlite database lives (see src/store.rs):
# long-term GA4 totals plus this site's own self-tracked page-serve hits.
# Defaults to a file in the working directory, fine for local dev; the
# Docker image points this at a mounted volume instead (see Dockerfile,
# deploy/run.sh) so counts survive restarts/redeploys.
# VISITOR_DB_PATH=./visitors.db

# The daily GA4 sync (src/ws_counter.rs) only ever runs when
# APP_ENV=production; leave it unset for local dev. Either way, the
# page-serve self-tracking (src/static_files.rs) always runs regardless of
# this setting, and the ticker only broadcasts when at least one browser
# has the counter open.
# APP_ENV=production

# How often (in whole minutes) the ticker wakes up to check for active
# connections and, if any exist, refresh the counts. Defaults to 1 if unset,
# zero, or not a number.
# VISITOR_TICK_INTERVAL_MINUTES=1

# Only read when APP_ENV=production above (see src/ga4.rs). Point
# GOOGLE_APPLICATION_CREDENTIALS at a GCP service-account JSON key with
# "Viewer" access on the GA4 property (Admin -> Property Access Management)
# - keep the key file itself outside the repo; it's gitignored by name
# below but don't rely on that.
# GOOGLE_APPLICATION_CREDENTIALS=./ga4-credentials.json
# GA4_PROPERTY_ID=123456789

# How many of the most-visited pages (by total users) the GA4 report pulls
# back - not a fixed list of tracked pages. Defaults to 50 if unset.
# GA4_TOP_PAGES_LIMIT=50

# Only set this to "true" if this server sits behind Cloudflare (proxied
# DNS) *and* the origin is firewalled to only accept connections from
# Cloudflare's published IP ranges (https://www.cloudflare.com/ips/).
# When true, the visitor tracker (src/visitor_key.rs) trusts the
# CF-Connecting-IP header for the real client IP instead of the TCP peer
# address, which would otherwise always be Cloudflare's edge. Left unset
# (the default), CF-Connecting-IP is ignored even if present - a client
# could otherwise spoof it by just sending the header directly.
# TRUST_CF_CONNECTING_IP=true
